# ── Stage 1: deps ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS deps

WORKDIR /app
COPY apps/personal/frontend/package.json apps/personal/frontend/package-lock.json* ./
RUN npm ci --prefer-offline


# ── Stage 2: builder ──────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/personal/frontend .

RUN npm run build


# ── Stage 3: runtime (nginx static) ───────────────────────────────────────────
# next.config.mjs uses output:"export" — build output is plain HTML/JS/CSS in /out
FROM nginx:alpine AS runner

# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*

# Copy static export
COPY --from=builder /app/out /usr/share/nginx/html

# nginx config: serve SPA, proxy /api/* to backend
COPY docker/personal/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
