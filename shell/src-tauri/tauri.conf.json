{
  "build": {
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devPath": "http://localhost:3001",
    "distDir": "../frontend/out"
  },
  "package": {
    "productName": "LOQA",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "execute": true,
        "scope": [{ "name": "run-app", "cmd": "$APPDATA/LOQA/apps/**", "args": true }]
      },
      "path": { "all": true },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "createDir": true,
        "scope": ["$APPDATA/LOQA/**", "$APPLOCAL/LOQA/**"]
      },
      "http": {
        "all": false,
        "request": true,
        "scope": ["https://**", "http://localhost/**"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.knowledgeai.shell",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "LOQA",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 500
      }
    ]
  }
}
